# Copy to .env and fill in.

# Option A (default): Gemini API key from Google AI Studio
GOOGLE_API_KEY=your-api-key-here
# AI Studio names the TTS model differently from Vertex:
RAKSHAK_TTS_MODEL=gemini-2.5-flash-preview-tts

# Option B: Vertex AI / Gemini Enterprise with gcloud ADC
# (comment out Option A, then `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# RAKSHAK_TTS_MODEL=gemini-2.5-flash-tts

# Optional overrides
# RAKSHAK_MODEL=gemini-3.8-flash
# RAKSHAK_THINKING=low
